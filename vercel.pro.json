{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "_note": "لخطة Vercel Pro فقط: مزامنة الكالندر كل ربع ساعة. غير اسم هذا الملف الى vercel.json لو رقيت لـ Pro.",
  "crons": [
    { "path": "/api/cron/calendar_sync", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/daily_digest", "schedule": "0 4 * * *" },
    { "path": "/api/cron/rollover", "schedule": "30 21 * * *" },
    { "path": "/api/cron/neglect_nudge", "schedule": "0 5 * * *" },
    { "path": "/api/cron/weekly_review", "schedule": "0 3 * * 6" },
    { "path": "/api/cron/snapshot", "schedule": "10 3 * * 6" }
  ]
}
